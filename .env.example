# Stripe (backend only – do not commit real keys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Comma-separated origins allowed by CORS (server adds localhost/127.0.0.1 for same port).
FRONTEND_URL=http://localhost:3000
# Optional: backend URL for checkout. In dev, defaults to http://localhost:4242 if empty.
VITE_CHECKOUT_API_URL=
# Optional: Stripe Payment Link URL. When set, "GO TO CHECKOUT" redirects here instead of embedded checkout.
# Example: VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_xxxxx
VITE_STRIPE_PAYMENT_LINK_URL=
# Shipping: standard $5.99 (2-5 days), free over $69; upgrade +$7 (1-3 days). Set both backend + frontend.
SHIPPING_STANDARD=5.99
FREE_SHIPPING_THRESHOLD=69
SHIPPING_UPGRADE_ADD=7
VITE_SHIPPING_STANDARD=5.99
VITE_FREE_SHIPPING_THRESHOLD=69
VITE_SHIPPING_UPGRADE_ADD=7
# Required for embedded Stripe Checkout (when VITE_STRIPE_PAYMENT_LINK_URL is not set).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here


# Resend (联系表单 + 订单通知，需验证域名)
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM="One Sip One Brush <onboarding@resend.dev>"
SHOP_OWNER_EMAIL=sipbrush@gmail.com

# Mailchimp (newsletter subscription – backend only)
MAILCHIMP_API_KEY=your_api_key_us11
MAILCHIMP_LIST_ID=your_audience_list_id
